#include <dt-bindings/zmk/matrix_transform.h>
#include "miryoku_layout.h"

/ {
    chosen {
        zmk,kscan = &kscan_composite;
        zmk,matrix_transform = &default_transform;
    };


default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <8>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)  RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)  RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)  RC(6,0) RC(6,1) RC(6,2) RC(6,3) RC(6,4)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)  RC(7,0) RC(7,1) RC(7,2) RC(7,3) RC(7,4)
        >;
    };

    kscan_composite: kscan_composite {
        compatible = "zmk,kscan-composite";
        rows = <8>;
        columns = <5>;
        left {
            kscan = <&kscan_left>;
        };
        right {
            kscan = <&kscan_right>;
            row-offset = <4>; // Move right side to rows 4-7
        };
    };

    kscan_left: kscan_left {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        row-gpios = <&gpio0 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>, 
                    <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>, 
                    <&gpio0 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>, 
                    <&gpio0 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        col-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>, 
                    <&gpio0 1 GPIO_ACTIVE_HIGH>, 
                    <&gpio0 2 GPIO_ACTIVE_HIGH>, 
                    <&gpio0 3 GPIO_ACTIVE_HIGH>, 
                    <&gpio0 4 GPIO_ACTIVE_HIGH>;
    };

    kscan_right: kscan_right {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        row-gpios = <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>, 
                    <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>, 
                    <&gpio0 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>, 
                    <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        col-gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>, 
                    <&gpio0 27 GPIO_ACTIVE_HIGH>, 
                    <&gpio0 26 GPIO_ACTIVE_HIGH>, 
                    <&gpio0 22 GPIO_ACTIVE_HIGH>, 
                    <&gpio0 21 GPIO_ACTIVE_HIGH>;
    };
};
